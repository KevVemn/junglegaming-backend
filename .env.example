SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=30s

DB_HOST=localhost
DB_PORT=5432
DB_USER=junglegaming
DB_PASSWORD=junglegaming
DB_NAME=junglegaming
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

AUTH_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8081/realms/junglegaming
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/junglegaming
OIDC_AUDIENCE=wagering-api
OIDC_PROVIDER_CLAIM=provider_id
OIDC_INTERNAL_CLAIM=scope_internal

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_VISIBILITY_TIMEOUT=30
SQS_MAX_RECEIVE_COUNT=5
SQS_WORKER_COUNT=4

OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=1s
OUTBOX_LOCK_DURATION=30s
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF=1s

REFERENCE_TTL=24h
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_POLL_INTERVAL=2s

LOG_LEVEL=info
LOG_FORMAT=json
